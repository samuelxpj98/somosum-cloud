
import React, { useState, useRef, useEffect } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { Expresso } from '../types';
import { GoogleGenAI } from "@google/genai";

interface EditorExpressoProps {
  onPublish: (expresso: Expresso) => void;
  userPosts: Expresso[];
  isDarkMode?: boolean;
}

const CATEGORY_SUGGESTIONS = [
  { label: 'FÉ E CIÊNCIA', icon: 'science', color: 'text-blue-600', bg: 'bg-blue-50' },
  { label: 'EVIDÊNCIAS', icon: 'history_edu', color: 'text-amber-700', bg: 'bg-amber-50' },
  { label: 'FÉ E CULTURA', icon: 'theater_comedy', color: 'text-purple-600', bg: 'bg-purple-50' },
  { label: 'SEXUALIDADE', icon: 'favorite', color: 'text-rose-500', bg: 'bg-rose-50' },
  { label: 'IDENTIDADE', icon: 'fingerprint', color: 'text-indigo-600', bg: 'bg-indigo-50' },
  { label: 'DOR', icon: 'sentiment_very_dissatisfied', color: 'text-red-600', bg: 'bg-red-50' },
  { label: 'BATISTA', icon: 'water_drop', color: 'text-cyan-600', bg: 'bg-cyan-50' },
];

const EditorExpresso: React.FC<EditorExpressoProps> = ({ onPublish, userPosts, isDarkMode }) => {
  const navigate = useNavigate();
  const { id } = useParams<{ id: string }>();
  const fileInputRef = useRef<HTMLInputElement>(null);
  const isDark = isDarkMode;
  
  const [title, setTitle] = useState('');
  const [category, setCategory] = useState('FÉ E CIÊNCIA');
  const [sectionLabel, setSectionLabel] = useState('A ANALOGIA');
  const [highlightText, setHighlightText] = useState('');
  const [content, setContent] = useState('');
  const [bibleRef, setBibleRef] = useState('');
  const [isClassic, setIsClassic] = useState(false);
  const [imagePreview, setImagePreview] = useState<string | null>(null);
  const [isCategoryModalOpen, setIsCategoryModalOpen] = useState(false);
  const [isGeneratingImage, setIsGeneratingImage] = useState(false);

  useEffect(() => {
    if (id) {
      const post = userPosts.find(p => p.id === id);
      if (post) {
        setTitle(post.title);
        setCategory(post.categoryFull || post.category);
        setSectionLabel(post.analogy?.title || 'A ANALOGIA');
        setHighlightText(post.analogy?.text || post.subtitle || '');
        setContent(post.content);
        setBibleRef(post.bibleReference || '');
        setIsClassic(post.isClassic || false);
        setImagePreview(post.imageUrl);
      }
    }
  }, [id, userPosts]);

  const handleImageChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    const file = e.target.files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onloadend = () => setImagePreview(reader.result as string);
      reader.readAsDataURL(file);
    }
  };

  const generateAIImage = async () => {
    if (!title) { 
      alert("Por favor, defina um título para que a IA possa gerar uma imagem contextualizada."); 
      return; 
    }
    setIsGeneratingImage(true);
    try {
      const ai = new GoogleGenAI({ apiKey: process.env.API_KEY });
      const prompt = `Minimalist 3D isometric illustration about "${title}". Clean background, soft cinematic lighting, professional digital art, no text, high quality.`;
      const response = await ai.models.generateContent({
        model: 'gemini-2.5-flash-image',
        contents: { parts: [{ text: prompt }] },
        config: { imageConfig: { aspectRatio: "16:9" } }
      });
      
      const parts = response.candidates?.[0]?.content?.parts;
      if (parts) {
        for (const part of parts) {
          if (part.inlineData) {
            setImagePreview(`data:image/png;base64,${part.inlineData.data}`);
            break;
          }
        }
      }
    } catch (error) { 
      console.error("Erro ao gerar imagem:", error);
      alert("Não foi possível gerar a imagem via IA no momento.");
    } finally { 
      setIsGeneratingImage(false); 
    }
  };

  const handleSave = (status: 'draft' | 'pending' | 'published') => {
    const newExpresso: Expresso = {
      id: id || Date.now().toString(),
      category: category.split(' ')[0],
      categoryFull: category,
      title: title || 'Sem Título',
      subtitle: highlightText || title.substring(0, 30),
      imageUrl: imagePreview || 'https://images.unsplash.com/photo-1507413245164-6160d8298b31?auto=format&fit=crop&q=80&w=800',
      content,
      readingTime: '1.5 MIN',
      isClassic,
      bibleReference: bibleRef,
      status: status,
      tags: [category.toLowerCase()],
      analogy: { 
        icon: CATEGORY_SUGGESTIONS.find(c => c.label === category)?.icon || "extension", 
        title: sectionLabel || 'A ANALOGIA', 
        text: highlightText 
      }
    };
    onPublish(newExpresso);
    navigate('/editor');
  };

  return (
    <div className={`min-h-screen pb-32 transition-colors duration-300 ${isDark ? 'bg-slate-950 text-white' : 'bg-white text-slate-900'}`}>
      {/* Modal de Categoria */}
      {isCategoryModalOpen && (
        <div className="fixed inset-0 z-[100] flex items-end justify-center px-4 pb-4 animate-in fade-in duration-300">
          <div className="fixed inset-0 bg-slate-950/60 backdrop-blur-md" onClick={() => setIsCategoryModalOpen(false)}></div>
          <div className={`relative w-full max-w-md rounded-[40px] shadow-2xl overflow-hidden p-8 animate-in slide-in-from-bottom-10 duration-500 ${isDark ? 'bg-slate-900' : 'bg-white'}`}>
             <div className="flex justify-between items-center mb-6">
                <h3 className="text-xl font-[900] font-display">Escolher Tema</h3>
                <button onClick={() => setIsCategoryModalOpen(false)} className="size-8 rounded-full bg-slate-100 flex items-center justify-center text-slate-400">
                  <span className="material-symbols-outlined text-lg">close</span>
                </button>
             </div>
             <div className="grid grid-cols-2 gap-3 max-h-[60vh] overflow-y-auto no-scrollbar pr-2">
                {CATEGORY_SUGGESTIONS.map(s => (
                  <button 
                    key={s.label} 
                    onClick={() => { setCategory(s.label); setIsCategoryModalOpen(false); }} 
                    className={`p-5 rounded-3xl border-2 transition-all flex flex-col items-center gap-2 group ${category === s.label ? 'border-blue-600 bg-blue-50/10' : (isDark ? 'border-slate-800 bg-slate-800' : 'border-slate-50 bg-slate-50/50')}`}
                  >
                    <span className={`material-symbols-outlined text-[28px] transition-transform group-active:scale-110 ${s.color}`}>{s.icon}</span>
                    <p className={`text-[10px] font-black uppercase tracking-tighter ${isDark ? 'text-slate-300' : 'text-slate-600'}`}>{s.label}</p>
                  </button>
                ))}
             </div>
          </div>
        </div>
      )}

      <header className={`sticky top-0 z-50 flex items-center justify-between px-6 py-6 border-b backdrop-blur-md transition-colors ${isDark ? 'bg-slate-900/90 border-slate-800' : 'bg-white/90 border-slate-50'}`}>
        <button onClick={() => navigate('/editor')} className="text-slate-400">
          <span className="material-symbols-outlined">arrow_back</span>
        </button>
        <h1 className="text-lg font-black font-display tracking-tight">{id ? 'Editar' : 'Novo'} Expresso</h1>
        <div className="w-10"></div>
      </header>

      <main className="p-6 space-y-10">
        {/* Capa com IA */}
        <section className="space-y-4">
          <div className="flex justify-between items-center px-1">
            <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest">Imagem de Capa</h3>
            <button 
              onClick={generateAIImage} 
              disabled={isGeneratingImage} 
              className={`text-[10px] font-black text-blue-600 uppercase flex items-center gap-1.5 transition-all ${isGeneratingImage ? 'opacity-50' : 'hover:scale-105 active:scale-95'}`}
            >
              <span className={`material-symbols-outlined text-sm ${isGeneratingImage ? 'animate-spin' : ''}`}>auto_awesome</span> 
              {isGeneratingImage ? 'Criando arte...' : 'Gerar com IA'}
            </button>
          </div>
          <div 
            onClick={() => !isGeneratingImage && fileInputRef.current?.click()} 
            className={`w-full aspect-[16/9] border-2 border-dashed rounded-[32px] flex flex-col items-center justify-center cursor-pointer overflow-hidden transition-all shadow-inner ${isDark ? 'border-slate-800 bg-slate-900/50' : 'border-blue-100 bg-slate-50/50'}`}
          >
            {imagePreview ? (
              <img src={imagePreview} className="w-full h-full object-cover animate-in fade-in zoom-in duration-500" alt="Preview" />
            ) : (
              <div className="flex flex-col items-center gap-2 opacity-30">
                <span className="material-symbols-outlined text-4xl">add_photo_alternate</span>
                <span className="text-[10px] font-black uppercase">Clique para subir</span>
              </div>
            )}
            <input type="file" ref={fileInputRef} onChange={handleImageChange} className="hidden" accept="image/*" />
          </div>
        </section>

        {/* Categoria */}
        <section className="space-y-3">
          <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Tema da Resposta</h3>
          <button 
            onClick={() => setIsCategoryModalOpen(true)}
            className={`w-full h-16 px-6 rounded-2xl flex items-center justify-between border-2 transition-all active:scale-[0.99] ${isDark ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-white shadow-sm'}`}
          >
            <div className="flex items-center gap-3">
              <span className={`material-symbols-outlined ${CATEGORY_SUGGESTIONS.find(c => c.label === category)?.color}`}>
                {CATEGORY_SUGGESTIONS.find(c => c.label === category)?.icon}
              </span>
              <span className="text-xs font-black uppercase tracking-widest">{category}</span>
            </div>
            <span className="material-symbols-outlined text-slate-300">expand_more</span>
          </button>
        </section>

        {/* Título */}
        <section className="space-y-3">
          <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Pergunta (Título)</h3>
          <textarea 
            placeholder="Ex: Como a Bíblia foi escrita?"
            className={`w-full h-24 p-6 rounded-[28px] font-black text-xl border-none focus:ring-4 focus:ring-blue-500/10 transition-all resize-none ${isDark ? 'bg-slate-900 text-white placeholder:text-slate-800' : 'bg-slate-50 text-slate-900 placeholder:text-slate-200 shadow-inner'}`} 
            value={title} 
            onChange={e => setTitle(e.target.value)} 
          />
        </section>

        {/* Analogia / Subtítulo */}
        <section className={`p-8 rounded-[40px] border-2 space-y-6 shadow-lg ${isDark ? 'bg-slate-900/40 border-slate-800' : 'bg-blue-50/30 border-blue-50'}`}>
           <div className="flex items-center gap-3">
              <div className="size-10 bg-blue-600 rounded-2xl flex items-center justify-center text-white shadow-lg">
                <span className="material-symbols-outlined text-[20px]">lightbulb</span>
              </div>
              <input 
                type="text"
                placeholder="Título da Analogia"
                className={`flex-1 bg-transparent font-black text-[10px] uppercase tracking-[0.2em] border-none focus:ring-0 ${isDark ? 'text-slate-300' : 'text-slate-400'}`}
                value={sectionLabel}
                onChange={e => setSectionLabel(e.target.value)}
              />
           </div>
           <textarea 
              value={highlightText} 
              placeholder="Explique com uma analogia simples..."
              onChange={e => setHighlightText(e.target.value)} 
              className={`w-full h-24 p-5 rounded-2xl font-bold text-sm border-none focus:ring-2 focus:ring-blue-500/10 resize-none ${isDark ? 'bg-slate-900 text-white' : 'bg-white text-slate-800 shadow-sm'}`} 
           />
        </section>

        {/* Conteúdo Principal */}
        <section className="space-y-3">
          <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Explicação Completa</h3>
          <textarea 
            placeholder="Desenvolva a resposta aqui..."
            className={`w-full h-56 p-6 rounded-[32px] border-none focus:ring-4 focus:ring-blue-500/10 transition-all text-sm leading-relaxed font-medium ${isDark ? 'bg-slate-900 text-slate-300' : 'bg-slate-50 text-slate-700 shadow-inner'}`} 
            value={content} 
            onChange={e => setContent(e.target.value)} 
          />
        </section>

        {/* Referência Bíblica */}
        <section className="space-y-3">
          <h3 className="text-[10px] font-black text-slate-400 uppercase tracking-widest px-1">Referência Base</h3>
          <div className={`h-16 px-6 rounded-2xl flex items-center gap-3 border-2 ${isDark ? 'bg-slate-900 border-slate-800' : 'bg-slate-50 border-white shadow-sm'}`}>
            <span className="material-symbols-outlined text-blue-600">menu_book</span>
            <input 
              type="text"
              placeholder="Ex: João 14:6"
              className={`flex-1 bg-transparent text-sm font-black uppercase tracking-widest focus:ring-0 border-none ${isDark ? 'text-white placeholder:text-slate-800' : 'text-slate-900 placeholder:text-slate-200'}`}
              value={bibleRef}
              onChange={e => setBibleRef(e.target.value)}
            />
          </div>
        </section>

        {/* Ações */}
        <div className="flex gap-4 pt-4">
          <button 
            onClick={() => handleSave('draft')} 
            className={`flex-1 h-16 rounded-[24px] font-black uppercase text-[10px] tracking-[0.2em] transition-all active:scale-95 ${isDark ? 'bg-slate-800 text-white hover:bg-slate-700' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'}`}
          >
            Rascunho
          </button>
          <button 
            onClick={() => handleSave('published')} 
            className="flex-[2] h-16 bg-blue-600 text-white rounded-[24px] font-black uppercase text-[11px] tracking-[0.2em] shadow-2xl shadow-blue-600/30 transition-all active:scale-95 flex items-center justify-center gap-2"
          >
            Publicar Expresso
            <span className="material-symbols-outlined text-sm">send</span>
          </button>
        </div>
      </main>
    </div>
  );
};

export default EditorExpresso;
